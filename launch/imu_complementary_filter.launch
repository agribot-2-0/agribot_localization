<launch>

  <!-- Complementary filter -->
  <node name="agribot_imu_complementary_filter" pkg="imu_complementary_filter" type="complementary_filter_node" respawn="true" >
    <param name="use_mag"               value="true" type="bool"/>
    <param name="gain_acc"              value="0.01" type="double"/>
    <param name="gain_mag"              value="0.99" type="double"/>
    <param name="bias_alpha"            value="0.01" type="double"/>
    <param name="do_bias_estimation"    value="true" type="bool"/>
    <param name="do_adaptive_gain"      value="true" type="bool"/>

    <param name="publish_debug_topics"  value="false" type="bool"/>
    <param name="publish_tf"            value="false" type="bool"/>

    <remap from="imu/data_raw"  to="agribot/imu/raw" />
    <remap from="imu/mag"       to="agribot/magnetic_field" />
    <remap from="imu/data"      to="agribot/imu/prefiltered" />

  </node>

</launch>
