<launch>

  <!-- IMU filter -->
  <include file="$(find agribot_localization)/launch/imu_filter.launch" />

  <!-- Forward kinematics -->
  <node name="odometry_node" pkg="agribot_localization" type="odometry_node" respawn="true" />

  <!-- Odometry filter (front -> base) -->
  <node name="odometry_filter" pkg="agribot_localization" type="filter_test" respawn="true" />


</launch>
