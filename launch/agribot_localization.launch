<launch>
  <!-- EKF/UKF selection -->
  <arg name="use_ukf" default="false" />

  <!-- IMU filter -->
  <!-- <include file="$(find agribot_localization)/launch/imu_complementary_filter.launch" /> -->
  <include file="$(find agribot_localization)/launch/imu_madgwick_filter.launch" />

  <!-- Odometry -->
  <include file="$(find agribot_localization)/launch/odometry.launch"/>

  <!-- Navsat transform -->
  <include file="$(find agribot_localization)/launch/navsat_transform.launch" />

  <!-- Robot localization -->
  <include file="$(find agribot_localization)/launch/robot_localization.launch" >
    <arg name="use_ukf" value="$(arg use_ukf)" />
  </include>

  <!-- Translation of estimated odometry for map->odom EKF -->
  <remap from="odom_to_navsatfix_node_1/input_odometry" to="/agribot/odom/prefiltered"/>
  <remap from="odom_to_navsatfix_node_1/translated_navsatfix" to="/agribot/map_odom_navsatfix"/>
  <remap from="odom_to_navsatfix_node_1/input_navsatfix" to="/agribot/gnss"/>
  <node pkg="agribot_localization" type="odom_to_navsatfix_node" name="odom_to_navsatfix_node_1" />

  <!-- Translation of estimated odometry for odom->base_footprint EKF -->
  <remap from="odom_to_navsatfix_node_2/input_odometry" to="/agribot/odom/estimated"/>
  <remap from="odom_to_navsatfix_node_2/translated_navsatfix" to="/agribot/odom_base_navsatfix"/>
  <remap from="odom_to_navsatfix_node_2/input_navsatfix" to="/agribot/gnss"/>
  <node pkg="agribot_localization" type="odom_to_navsatfix_node" name="odom_to_navsatfix_node_2" />

</launch>
