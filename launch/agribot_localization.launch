<launch>
  <!-- EKF/UKF selection -->
  <arg name="use_ukf" default="false" />

  <!-- IMU filter -->
  <!-- <include file="$(find agribot_localization)/launch/imu_complementary_filter.launch" /> -->
  <include file="$(find agribot_localization)/launch/imu_madgwick_filter.launch" />

  <!-- Odometry -->
  <include file="$(find agribot_localization)/launch/odometry.launch"/>

  <!-- Navsat transform -->
  <include file="$(find agribot_localization)/launch/navsat_transform.launch" />

  <!-- Robot localization -->
  <include file="$(find agribot_localization)/launch/robot_localization.launch" >
    <arg name="use_ukf" value="$(arg use_ukf)" />
  </include>

</launch>
