<launch>

  <arg name="tf_source" default="$(env AGRIBOT_LOCALIZATION_TF_SOURCE)" />

  <node pkg="topic_tools" type="relay" name="gnss_filtered_relay" args="/agribot/gnss/$(arg tf_source)/filtered /agribot/gnss/filtered" />
  <node pkg="topic_tools" type="relay" name="odom_local_relay" args="/agribot/odom/local/$(arg tf_source) /agribot/odom/local" />
  <node pkg="topic_tools" type="relay" name="odom_global_relay" args="/agribot/odom/global/$(arg tf_source) /agribot/odom/global" />

  <!-- Bynav localization -->
  <include file="$(find agribot_localization)/launch/bynav/bynav_navsat_transform.launch">
    <arg name="publish_tf" value="$(eval arg('tf_source') == 'bynav')" />
  </include>

  <include file="$(find agribot_localization)/launch/bynav/bynav_robot_localization_single.launch">
    <arg name="publish_tf" value="$(eval arg('tf_source') == 'bynav')" />
  </include>

  <!-- Hydrabox localization -->
  <include file="$(find agribot_localization)/launch/hydrabox/hydrabox_navsat_transform.launch">
    <arg name="publish_tf" value="$(eval arg('tf_source') == 'hydrabox')" />
  </include>

  <include file="$(find agribot_localization)/launch/hydrabox/hydrabox_robot_localization_single.launch">
    <arg name="publish_tf" value="$(eval arg('tf_source') == 'hydrabox')" />
  </include>

  <!-- GPSFix visualization for mapviz (debug) -->
  <node pkg="agribot_localization" type="rewrite_navsatfix_to_gpsfix.py" name="rewrite_navsatfix_to_gpsfix_node" />

  <!-- Odometry -->
  <include file="$(find agribot_localization)/launch/odometry.launch" />

</launch>
