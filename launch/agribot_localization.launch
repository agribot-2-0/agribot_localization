<launch>
  <!-- IMU filter -->
  <include file="$(find agribot_localization)/launch/imu_madgwick_filter.launch" />

  <!-- Declination correction -->
  <param name="/imu_declination_correction_node/wmm_config_filepath" value="$(env AGRIBOT_HOME)/agribot/configs/base/localization/WMM.COF" />
  <node pkg="agribot_localization" type="imu_declination_correction_node.py" name="imu_declination_correction_node" />

  <!-- Odometry -->
  <include file="$(find agribot_localization)/launch/odometry.launch" />

  <!-- Navsat transform -->
  <include file="$(find agribot_localization)/launch/navsat_transform.launch" />

  <!-- Robot localization -->
  <include file="$(find agribot_localization)/launch/robot_localization.launch" />

</launch>
