<launch>
  <!-- EKF/UKF selection -->
  <arg name="publish_tf" default="true" />
  <arg name="use_ukf" default="$(env AGRIBOT_LOCALIZATION_USE_UKF)" />

  <arg name="global_odom_topic" value="agribot/odom/global/bynav" />
  <arg name="local_odom_topic" value="agribot/odom/local/bynav" />

  <!-- Extended Kalman Filter -->
  <group unless="$(arg use_ukf)">
    <!-- Local KF -->
    <node pkg="robot_localization" type="ekf_localization_node" name="bynav_localization_local" clear_params="true" respawn="true">
      <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/bynav/bynav_local_kf.yaml" />
      <param name="publish_tf" value="$(arg publish_tf)" />

      <remap from="odometry/filtered" to="$(arg local_odom_topic)" />
      <remap from="set_pose" to="set_bynav_local_pose" />
    </node>

    <!-- Global KF -->
    <node pkg="robot_localization" type="ekf_localization_node" name="bynav_localization_global" clear_params="true" respawn="true">
      <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/bynav/bynav_global_kf.yaml" />
      <param name="publish_tf" value="$(arg publish_tf)" />

      <remap from="odometry/filtered" to="$(arg global_odom_topic)" />
      <remap from="set_pose" to="set_bynav_global_pose" />
    </node>
  </group>

  <!-- Unscented Kalman Filter -->
  <group if="$(arg use_ukf)">
    <!-- Local KF -->
    <node pkg="robot_localization" type="ukf_localization_node" name="bynav_localization_local" clear_params="true" respawn="true">
      <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/bynav/bynav_local_kf.yaml" />
      <param name="publish_tf" value="$(arg publish_tf)" />

      <remap from="odometry/filtered" to="$(arg local_odom_topic)" />
      <remap from="set_pose" to="set_bynav_local_pose" />
    </node>

    <!-- Global KF -->
    <node pkg="robot_localization" type="ukf_localization_node" name="bynav_localization_global" clear_params="true" respawn="true">
      <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/bynav/bynav_global_kf.yaml" />
      <param name="publish_tf" value="$(arg publish_tf)" />

      <remap from="odometry/filtered" to="$(arg global_odom_topic)" />
      <remap from="set_pose" to="set_bynav_global_pose" />
    </node>
  </group>

</launch>
