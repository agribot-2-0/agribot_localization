<launch>

  <arg name="publish_tf" default="true" />

  <node pkg="robot_localization" type="navsat_transform_node" name="bynav_navsat_transform" respawn="true">

    <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/navsat_transform.yaml" />
    <param name="broadcast_cartesian_transform" value="$(arg publish_tf)" />

    <remap from="imu/data" to="agribot/heading/bynav" />
    <remap from="gps/fix" to="agribot/gnss/bynav" />
    <remap from="odometry/filtered" to="agribot/odom/local/bynav" />
    <remap from="odometry/gps" to="agribot/odom/gps/bynav" />
    <remap from="gps/filtered" to="agribot/gnss/bynav/filtered" />
  </node>

</launch>
