<launch>

    <!-- ########### Configuration arguments ########### -->
    <!-- EKF/UKF selection -->
    <arg name="use_ukf" default="false" />

    <!-- ########### Launch navsat_transform_node (for GPS) ########### -->
    <include file="$(find agribot_localization)/launch/navsat_transform.launch" />

    <!-- ########### Launch EKF or UKF ########### -->
    <!-- Launch EKF -->
    <group unless="$(arg use_ukf)">

      <!-- First (map->odom) EKF -->
      <node   pkg="robot_localization"
              type="ekf_localization_node"
              name="agribot_localization_map_odom_ekf"
              clear_params="true"
              respawn="true" >

              <param name="world_frame" value="map" type="str"/>
              <rosparam command="load" file="$(find agribot_localization)/params/common.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/gps_odom.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/imu.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/heading.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/inclinometer.yaml" />
              <remap from="odometry/filtered" to="agribot/odom/prefiltered" />
              <remap from="set_pose" to="set_pose_map_odom" />
      </node>

      <!-- Second (odom->base_link) EKF -->
      <node   pkg="robot_localization"
              type="ekf_localization_node"
              name="agribot_localization_odom_baselink_ekf"
              clear_params="true"
              respawn="true" >

              <rosparam command="load" file="$(find agribot_localization)/params/common.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/prefiltered_odom.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/imu.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/heading.yaml" />
              <rosparam command="load" file="$(find agribot_localization)/params/sensors/inclinometer.yaml" />
              <remap from="odometry/filtered" to="agribot/odom/estimated" />
              <remap from="set_pose" to="set_pose_odom_baselink" />
      </node>
    </group>

    <!-- Launch UKF -->
    <group if="$(arg use_ukf)">

            <!-- First (map->odom) UKF -->
            <node   pkg="robot_localization"
                    type="ukf_localization_node"
                    name="agribot_localization_map_odom_ukf"
                    clear_params="true"
                    respawn="true" >

                    <param name="world_frame" value="map" type="str"/>
                    <rosparam command="load" file="$(find agribot_localization)/params/common.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/ukf.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/gps_odom.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/imu.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/heading.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/inclinometer.yaml" />
                    <remap from="odometry/filtered" to="agribot/odom/prefiltered" />
                    <remap from="set_pose" to="set_pose_map_odom" />
            </node>

            <!-- Second (odom->base_link) UKF -->
            <node   pkg="robot_localization"
                    type="ukf_localization_node"
                    name="agribot_localization_odom_baselink_ukf"
                    clear_params="true"
                    respawn="true" >

                    <rosparam command="load" file="$(find agribot_localization)/params/common.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/ukf.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/prefiltered_odom.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/raw_odom.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/imu.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/heading.yaml" />
                    <rosparam command="load" file="$(find agribot_localization)/params/sensors/inclinometer.yaml" />
                    <remap from="odometry/filtered" to="agribot/odom/estimated" />
                    <remap from="set_pose" to="set_pose_odom_baselink" />
            </node>
    </group>

</launch>
