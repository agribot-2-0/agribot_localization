<launch>

  <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/localization/robot_localization_navsat_transform.yaml" />

  <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform" respawn="true">
    <remap from="imu/data" to="agribot/imu/filtered" />
    <remap from="gps/fix" to="agribot/gnss" />
    <remap from="odometry/filtered" to="agribot/odom/global" />
    <remap from="odometry/gps" to="agribot/odom/gps" />
    <remap from="gps/filtered" to="agribot/gnss/filtered" />
  </node>

</launch>
