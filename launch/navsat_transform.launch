<launch>

    <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform_node" respawn="true">

      <param name="magnetic_declination_radians" value="0"/>
      <param name="yaw_offset" value="0"/>

      <remap from="imu/data" to="agribot/imu/filtered" />
      <remap from="gps/fix" to="agribot/gnss" />
      <remap from="odometry/filtered" to="agribot/odom/raw" />
      <remap from="odometry/gps" to="agribot/odom/gps" />

    </node>

</launch>
