<launch>

  <!-- Complementary filter -->
  <node name="agribot_imu_madgwick_filter" pkg="imu_filter_madgwick" type="imu_filter_node" respawn="true" >

    <param name="world_frame"             value="enu" type="string"/>
    <!-- <param name="world_frame"             value="nwu" type="string"/> -->

    <param name="use_mag"                 value="true" type="bool"/>
    <param name="use_magnetic_field_msg"  value="true" type="bool"/>

    <param name="gain"                    value="0.1" type="double"/>
    <param name="zeta"                    value="0.01" type="double"/>

    <param name="mag_bias_x"              value="0.00" type="double"/>
    <param name="mag_bias_y"              value="0.00" type="double"/>
    <param name="mag_bias_z"              value="0.00" type="double"/>
    <param name="orientation_stddev"      value="0.01" type="double"/>

    <param name="publish_debug_topics"    value="false" type="bool"/>
    <param name="publish_tf"              value="false" type="bool"/>

    <remap from="imu/data_raw"  to="agribot/imu/raw" />
    <remap from="imu/mag"       to="agribot/magnetic_field" />
    <remap from="imu/data"      to="agribot/imu/filtered" />

  </node>

</launch>
