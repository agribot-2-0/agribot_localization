@startuml agribot_localization

' External input interfaces
interface "/agribot/encoder/cart/(front/back)\n\
std_msgs/Float32.msg\n\n\
/agribot/encoder/caterpillar\n\
agribot_msgs/AgribotCaterpillar.msg" as encoder
interface "/agribot/imu/raw/data\n\
sensor_msgs/Imu.msg\n\n\
/agribot/imu/raw/mag\n\
sensor_msgs/MagneticField.msg" as imu_raw
interface "/agribot/gnss\nsensor_msgs/NavSatFix.msg" as gnss


' External output interfaces
interface "/agribot/gnss/filtered\nsensor_msgs/NavSatFix.msg" as gnss_filtered
interface "/agribot/odom/global\nav_msgs/Odometry.msg" as odom_global
interface "/tf (odom -> base_footprint)\ntf2_msgs/TFMessage.msg" as odom_base_tf
interface "/agribot/odom/local\nav_msgs/Odometry.msg" as odom_local
interface "/tf (map -> odom)\ntf2_msgs/TFMessage.msg" as map_odom_tf
interface "/tf_static (map -> utm)\ntf2_msgs/TFMessage.msg" as map_utm_tf


component agribot_localization {

  ' Components
  [IMU Transformer] as Transformer
  [IMU Madgwick Filter] as Madgwick
  [IMU Declination Correction] as Declination
  [Wheel Odometry] as WheelOdometry
  [Navsat Transform Node] as NavsatTransform
  [odom -> base_footprint KF\n(robot_localization)] as LocalKf
  [map -> odom KF\n(robot_localization)] as GlobalKf

  ' Interfaces
  interface "/agribot/imu/rotated/data\n\
sensor_msgs/Imu.msg\n\n\
/agribot/imu/rotated/mag\n\
sensor_msgs/MagneticField.msg" as imu_rotated
  interface "/agribot/imu/prefiltered\nsensor_msgs/Imu.msg" as imu_prefiltered
  interface "/agribot/imu/filtered\nsensor_msgs/Imu.msg" as imu_filtered
  interface "/agribot/odom/raw\n\
nav_msgs/Odometry.msg" as odom_raw
  interface "/agribot/odom/gps\n\
nav_msgs/Odometry.msg" as odom_gps

  ''' Internal connections '''
  ' Transformer
  Transformer -- imu_rotated

  ' Madgwick
  imu_rotated )-- Madgwick
  Madgwick -- imu_prefiltered

  ' Declination
  imu_prefiltered )-- Declination
  Declination -up-----( gnss
  Declination -- imu_filtered

  ' Wheel odometry
  WheelOdometry -- odom_raw

  ' Navsat transform
  NavsatTransform --( imu_filtered
  NavsatTransform -up-----( gnss
  NavsatTransform --( odom_global
  NavsatTransform -- odom_gps

  ' Local KF
  LocalKf -up-( imu_filtered
  LocalKf -up-( odom_raw

  ' Global KF
  GlobalKf -up-( imu_filtered
  GlobalKf -up-( odom_raw
  GlobalKf -up-( odom_gps

}

''' External connections '''
' Transformer
imu_raw )-- Transformer

' Wheel odometry
WheelOdometry -up-----( encoder

' Navsat transform
NavsatTransform --down-- map_utm_tf
NavsatTransform --down-- gnss_filtered

' Local KF
LocalKf -down- odom_base_tf
LocalKf -down- odom_local

' Global KF
GlobalKf -down- map_odom_tf
GlobalKf -down- odom_global

@enduml
